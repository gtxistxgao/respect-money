{
  "name": "respect-money",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch src/server/index.ts' 'vite --host 127.0.0.1'",
    "build": "vite build && tsup src/server/index.ts --format esm --out-dir dist/server --platform node --target node24",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "codex:check": "tsx scripts/check-codex.ts",
    "backup": "tsx scripts/backup.ts",
    "migrate:sqlite": "tsx scripts/migrate-sqlite.ts",
    "restore": "tsx scripts/backup.ts restore",
    "migrate:settings": "tsx scripts/migrate-settings.ts",
    "demo": "npm run build && tsx scripts/demo-server.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-select": "2.3.7",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "8.21.3",
    "decimal.js": "10.6.0",
    "fastify": "5.12.3",
    "lucide-react": "1.41.0",
    "plaid": "47.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-plaid-link": "5.0.0",
    "react-router-dom": "7.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
